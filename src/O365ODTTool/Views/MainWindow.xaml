<ui:FluentWindow
	x:Class="O365ODTTool.Views.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	xmlns:vm="clr-namespace:O365ODTTool.ViewModels"
	xmlns:controls="clr-namespace:O365ODTTool.Controls"
	xmlns:converters="clr-namespace:O365ODTTool.Converters"
	mc:Ignorable="d"
	d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
	Title="O365 ODT Tool"
	Icon="pack://application:,,,/Assets/AppIcon.ico"
	Width="1200"
	Height="900"
	MinWidth="960"
	MinHeight="640"
	WindowStartupLocation="CenterScreen"
	ExtendsContentIntoTitleBar="True"
	WindowBackdropType="Mica"
	WindowCornerPreference="Round">

	<ui:FluentWindow.Resources>
		<converters:EnumMatchConverter x:Key="EnumMatch" />
		<BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

		<Style x:Key="Card" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="16,12,16,16" />
			<Setter Property="Margin" Value="6" />
		</Style>

		<Style x:Key="CardTitle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="15" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Margin" Value="0,0,0,6" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
		</Style>

		<Style x:Key="FieldLabel" TargetType="TextBlock">
			<Setter Property="Margin" Value="0,10,0,4" />
			<Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
		</Style>

		<DataTemplate x:Key="CheckItem" DataType="{x:Type vm:SelectableItem}">
			<CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}" Margin="0,0,8,0" MinWidth="0" />
		</DataTemplate>

		<ItemsPanelTemplate x:Key="TwoColumns">
			<UniformGrid Columns="2" />
		</ItemsPanelTemplate>
	</ui:FluentWindow.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<ui:TitleBar Grid.Row="0" Title="O365 ODT Tool">
			<ui:TitleBar.Icon>
				<ui:ImageIcon Source="pack://application:,,,/Assets/AppIcon.ico" />
			</ui:TitleBar.Icon>
		</ui:TitleBar>

		<Grid Grid.Row="1" Margin="12,4,12,6">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<WrapPanel Grid.Column="0" VerticalAlignment="Center">
				<ui:Button Content="Import" Icon="{ui:SymbolIcon ArrowImport24}" Command="{Binding ImportCommand}" ToolTip="Import configuration from a file" Margin="0,0,6,0" />
				<ui:Button Content="Export" Icon="{ui:SymbolIcon Share24}" Command="{Binding ExportCommand}" ToolTip="Export configuration to a file" Margin="0,0,6,0" />
				<ui:Button Content="Preview" Icon="{ui:SymbolIcon Eye24}" Command="{Binding PreviewCommand}" ToolTip="Preview configuration file" Margin="0,0,6,0" />
				<ui:Button Content="Save" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveCommand}" ToolTip="Save as the default configuration" Margin="0,0,6,0" />
				<ui:Button Content="Reset" Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding ResetCommand}" ToolTip="Reset configuration to defaults" Appearance="Transparent" />
			</WrapPanel>

			<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}">
					<ui:ProgressRing IsIndeterminate="True" Width="22" Height="22" Margin="0,0,8,0" />
					<TextBlock Text="{Binding BusyText}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
					<ui:Button Content="Cancel" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CancelCommand}" ToolTip="Cancel the running operation" Margin="0,0,6,0" />
				</StackPanel>
				<ui:Button Content="Download" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding DownloadCommand}" ToolTip="Download Office installation files to a folder" Margin="0,0,6,0" />
				<ui:Button Content="Install" Icon="{ui:SymbolIcon Rocket24}" Command="{Binding InstallCommand}" ToolTip="Install Office on this computer" Appearance="Primary" />
			</StackPanel>
		</Grid>

		<ScrollViewer Grid.Row="2" Padding="6,0,6,6" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding IsIdle}">
			<Grid DataContext="{Binding Form}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0">
					<Border Style="{StaticResource Card}">
						<StackPanel>
							<TextBlock Style="{StaticResource CardTitle}" Text="Architecture" />
							<StackPanel Orientation="Horizontal">
								<RadioButton Content="64-bit" GroupName="Architecture" IsChecked="{Binding Architecture, Converter={StaticResource EnumMatch}, ConverterParameter=X64}" />
								<RadioButton Content="32-bit" GroupName="Architecture" IsChecked="{Binding Architecture, Converter={StaticResource EnumMatch}, ConverterParameter=X86}" />
							</StackPanel>
							<CheckBox Content="Change the architecture of an existing installation" IsChecked="{Binding MigrateArchitecture}" Margin="0,8,0,0" />
						</StackPanel>
					</Border>

					<Border Style="{StaticResource Card}">
						<StackPanel>
							<TextBlock Style="{StaticResource CardTitle}" Text="Products" />
							<TextBlock Style="{StaticResource FieldLabel}" Text="Office" />
							<ComboBox ItemsSource="{Binding SuiteOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding SuiteProductId}" />
							<ui:TextBox PlaceholderText="Product key (optional)" Text="{Binding SuiteProductKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Visibility="{Binding IsSuiteVolume, Converter={StaticResource BooleanToVisibility}}" />
							<TextBlock Style="{StaticResource FieldLabel}" Text="Visio" />
							<ComboBox ItemsSource="{Binding VisioOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding VisioProductId}" />
							<ui:TextBox PlaceholderText="Product key (optional)" Text="{Binding VisioProductKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Visibility="{Binding IsVisioVolume, Converter={StaticResource BooleanToVisibility}}" />
							<TextBlock Style="{StaticResource FieldLabel}" Text="Project" />
							<ComboBox ItemsSource="{Binding ProjectOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding ProjectProductId}" />
							<ui:TextBox PlaceholderText="Product key (optional)" Text="{Binding ProjectProductKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Visibility="{Binding IsProjectVolume, Converter={StaticResource BooleanToVisibility}}" />
						</StackPanel>
					</Border>

					<Border Style="{StaticResource Card}">
						<StackPanel IsEnabled="{Binding HasSuite}">
							<Grid>
								<TextBlock Style="{StaticResource CardTitle}" Text="Applications" />
								<CheckBox Content="All" IsChecked="{Binding AllAppsSelected}" HorizontalAlignment="Right" MinWidth="0" Margin="0,0,8,6" />
							</Grid>
							<ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource CheckItem}" ItemsPanel="{StaticResource TwoColumns}" />
						</StackPanel>
					</Border>

					<Border Style="{StaticResource Card}">
						<StackPanel>
							<TextBlock Style="{StaticResource CardTitle}" Text="General" />
							<TextBlock Style="{StaticResource FieldLabel}" Text="Organization name" />
							<ui:TextBox Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" />
							<TextBlock Style="{StaticResource FieldLabel}" Text="Configuration description" />
							<ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
						</StackPanel>
					</Border>
				</StackPanel>

				<StackPanel Grid.Column="1">
					<Border Style="{StaticResource Card}">
						<StackPanel>
							<TextBlock Style="{StaticResource CardTitle}" Text="Languages" />
							<TextBlock Style="{StaticResource FieldLabel}" Text="Primary language" />
							<ComboBox ItemsSource="{Binding PrimaryLanguageOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding PrimaryLanguage}" />
							<TextBlock Style="{StaticResource FieldLabel}" Text="Additional languages" />
							<controls:CheckComboBox ItemsSource="{Binding AdditionalLanguages}" Text="{Binding AdditionalLanguagesSummary}" />
							<TextBlock Style="{StaticResource FieldLabel}" Text="Proofing tools" />
							<controls:CheckComboBox ItemsSource="{Binding ProofingLanguages}" Text="{Binding ProofingLanguagesSummary}" />
						</StackPanel>
					</Border>

					<Border Style="{StaticResource Card}">
						<StackPanel>
							<TextBlock Style="{StaticResource CardTitle}" Text="Updates" />
							<TextBlock Style="{StaticResource FieldLabel}" Text="Channel" />
							<ComboBox ItemsSource="{Binding ChannelOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding Channel}" />
							<ui:ToggleSwitch Content="Update automatically" IsChecked="{Binding UpdatesEnabled}" Margin="0,12,0,0" />
						</StackPanel>
					</Border>

					<Border Style="{StaticResource Card}">
						<StackPanel>
							<TextBlock Style="{StaticResource CardTitle}" Text="Installation" />
							<TextBlock Style="{StaticResource FieldLabel}" Text="Setup interface" />
							<StackPanel Orientation="Horizontal">
								<RadioButton Content="Full" GroupName="DisplayLevel" IsChecked="{Binding DisplayLevel, Converter={StaticResource EnumMatch}, ConverterParameter=Full}" />
								<RadioButton Content="Silent" GroupName="DisplayLevel" IsChecked="{Binding DisplayLevel, Converter={StaticResource EnumMatch}, ConverterParameter=None}" />
							</StackPanel>
							<CheckBox Content="Accept the license agreement" IsChecked="{Binding AcceptEula}" Margin="0,8,0,0" />
							<CheckBox Content="Remove previous MSI versions of Office" IsChecked="{Binding RemoveMsi}" />
							<CheckBox Content="Close running Office applications" IsChecked="{Binding ForceAppShutdown}" />
							<CheckBox Content="Pin application icons to the taskbar" IsChecked="{Binding PinIconsToTaskbar}" />
						</StackPanel>
					</Border>

					<Border Style="{StaticResource Card}">
						<StackPanel>
							<TextBlock Style="{StaticResource CardTitle}" Text="Licensing and activation" />
							<RadioButton Content="User based" GroupName="Licensing" IsChecked="{Binding Licensing, Converter={StaticResource EnumMatch}, ConverterParameter=UserBased}" />
							<RadioButton Content="Shared computer" GroupName="Licensing" IsChecked="{Binding Licensing, Converter={StaticResource EnumMatch}, ConverterParameter=SharedComputer}" />
							<RadioButton Content="Device based" GroupName="Licensing" IsChecked="{Binding Licensing, Converter={StaticResource EnumMatch}, ConverterParameter=DeviceBased}" />
							<CheckBox Content="Activate volume products automatically" IsChecked="{Binding AutoActivate}" Margin="0,8,0,0" />
						</StackPanel>
					</Border>
				</StackPanel>
			</Grid>
		</ScrollViewer>

		<ui:InfoBar Grid.Row="3" Margin="12,0,12,8" Title="Validation" Message="{Binding ValidationMessage}" Severity="{Binding ValidationSeverity}" IsOpen="{Binding HasValidationIssues}" IsClosable="False" />
	</Grid>
</ui:FluentWindow>
