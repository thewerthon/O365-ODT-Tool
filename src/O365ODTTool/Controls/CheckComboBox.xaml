<UserControl
	x:Class="O365ODTTool.Controls.CheckComboBox"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="clr-namespace:O365ODTTool.ViewModels"
	x:Name="Root">
	<Grid>
		<ComboBox
			x:Name="Selector"
			ItemsSource="{Binding ItemsSource, ElementName=Root}"
			MaxDropDownHeight="320"
			IsTextSearchEnabled="False"
			SelectionChanged="OnSelectionChanged">
			<ComboBox.ItemContainerStyle>
				<Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
					<Setter Property="HorizontalContentAlignment" Value="Stretch" />
					<Setter Property="Padding" Value="10,0" />
					<Setter Property="MinHeight" Value="0" />
				</Style>
			</ComboBox.ItemContainerStyle>
			<ComboBox.ItemTemplate>
				<DataTemplate DataType="{x:Type vm:SelectableItem}">
					<CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}" HorizontalAlignment="Stretch" MinWidth="0" />
				</DataTemplate>
			</ComboBox.ItemTemplate>
		</ComboBox>
		<TextBlock
			Text="{Binding Text, ElementName=Root}"
			Margin="12,0,40,0"
			VerticalAlignment="Center"
			TextTrimming="CharacterEllipsis"
			IsHitTestVisible="False"
			Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
	</Grid>
</UserControl>
